  - {fileID: 11400000, guid: fd5f894d7e4ccb843b2a4b824f112163, type: 2}
  fixedDialogue: "\uD5E5\u2026.\uD5E5\u2026\n\uC73C\u2026.\uBB34\uAC70\uC6CC..\n\uC548\uB155\u2026\uD558\u2026\uC138\uC694!!\n\uD639\uC2DC\u2026
    \uB2E8\uCCB4.. \uC8FC\uBB38..\uB3C4.. \uBC1B\u2026\uB098\uC694?\n\uADF8\uB9AC\uACE0\u2026\uC9C0\uAE08\u2026\uC2DC\uAC04\u2026\uC774
    \uC5C6\uC5B4\uC11C\u2026 \uBE68\uB9AC.. \uC880 \uAC00\uB2A5\u2026\uD560\u2026\uAE4C\uC694?\n\uCD2C\uC601\u2026.\uD300\uC5D0..\uAC16\uB2E4
    \uC918..\uC57C\u2026\uD574\uC11C\uC694\u2026\uD5E5\u2026\uD5E5\u2026"
  perfectDialogue:
  - "\uC774\u2026\uC815\uB3C4\uBA74.. \uCDA9\uBD84\u2026 \uD560..\uAC83 \uAC19\uC544\uC694\u2026!\n\uB355..\uBD84..\uC5D0..\uC548..\uB2A6\uAC8C
    \uC804\uB2EC \uD560 \uC218 \uC788\uACA0\uB124\uC694\u2026!\n\uAC10\uC0AC\u2026\uD569\uB2C8\uB2E4\u2026
    \uC0AC\uC7A5\uB2D8!"
  incompleteDialogue:
  - "\uBC8C\u2026\uC368 \uC2DC\uAC04\u2026.\uC774..\uC774\uB807\uAC8C\u2026.!!!\n\uC8C4\u2026\uC8C4\uC1A1\uD574\uC694
    \uC0AC\uC7A5\uB2D8!\n\uACB0\uC81C\uB294 \uB098\uC911\uC5D0 \uB2E4\uC2DC \uC640\uC11C
    \uD560\uAC8C\uC694\u2026!"
  wrongDialogue:
  - "\uBC8C\u2026\uC368 \uC2DC\uAC04\u2026.\uC774..\uC774\uB807\uAC8C\u2026.!!!\n\uC8C4\u2026\uC8C4\uC1A1\uD574\uC694
