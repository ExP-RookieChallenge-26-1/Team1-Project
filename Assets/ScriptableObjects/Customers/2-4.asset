  - {fileID: 11400000, guid: 8e5df99b452ae674286b324817d0897f, type: 2}
  fixedDialogue: "\uC624\uC624... \uB4DC\uB514\uC5B4 \uCC3E\uC558\uAD6C\uB098.\r\n\uD3C9\uBBFC\uC774\uC5EC
    \uC548\uB155\uD55C\uAC00, \uC774\uBAB8\uC740 \uAC00\uB974\uAC10\uD280\uC544 \uC655\uAD6D\uC758
    \uC81C 3\uAE30\uC0AC\uB2E8\uC7A5 \uD584\uBD80\uAE30 \uACBD\uC774\uB77C\uB124.\r\n\uBA70\uCE60
    \uC804, \uB9C8\uC871\uACFC \uC2F8\uC6B0\uB358 \uC911 \uC815\uCCB4\uBD88\uBA85\uC758
    \uB9C8\uBC95\uC5D0 \uD718\uB9D0\uB824 \uC774\uACF3\uC73C\uB85C \uB5A8\uC5B4\uC9C0\uACE0
    \uB9D0\uC558\uB290\uB2C8\uB77C.\r\n\uCC98\uC74C\uC5D0\uB294 \uB2F9\uD669\uD588\uC9C0\uB9CC,
    \uC774 \uBAB8\uC740 \uAE30\uC0AC!\r\n\uC5B4\uB5A4 \uC2DC\uB828\uC774 \uB2E5\uCE58\uB354\uB77C\uB3C4
    \uAD74\uD558\uC9C0 \uC54A\uACE0 \uC0B4\uC544\uB0A8\uC544 \uC654\uB178\uB77C.\r\n\uD5C8\uB098
    \uD55C \uAC00\uC9C0 \uBB38\uC81C\uAC00 \uC788\uC5C8\uAD6C\uB098.\r\n\uC774\uACF3\uC758
    \uC74C\uC2DD\uB4E4\uC740 \uC804\uBD80 \uCC98\uC74C \uBCF4\uB294 \uAC83\uB4E4\uBFD0...\r\n\uADF8\uB7EC\uB358
    \uC911 \uAE38\uAC70\uB9AC\uC5D0\uC11C \uD758\uB7EC\uB098\uC624\uB294 \uD5A5\uAE30\uB97C
    \uB9E1\uC558\uC9C0.\r\n\uADF8 \uC21C\uAC04 \uD655\uC2E0\uD558\uC600\uB2E4.\r\n\uC6B0\uB9AC
    \uAC00\uBB38\uC758 \uC2DC\uC791\uBD80\uD130 \uC804\uD574\uC838\uC624\uB358 \uC804\uC124\uC758
    \uC74C\uC2DD\u2026..\r\n\uC804\uC124\uC758 \uD584\uBD80\uAE30\uD584\uBD81 \uD584\uBD81\uC2A4\uB531\uC2A4
    \uD568\uBD80\uB974\uD06C\uD584\uBD80\uAC00\uC6B0\uAC00 \uD584\uBE44\uAE30\uD584\uBD80\uAC70
    \uD584\uBD80\uAC00\uD2F0\uD584\uBD80\uAE30\uC628\uC564 \uC628\uACFC \uB108\uBB34\uB3C4
    \uD761\uC0AC\uD55C \uD5A5\uAE30\uC600\uB290\uB2C8\uB77C!\r\n\uD639\uC2DC \uC774\uACF3\uC5D0\uB3C4
    \uADF8 \uC804\uC124\uC774 \uC804\uD574\uC9C0\uB294 \uAC83\uC774\uB354\uB0D0?\r\n\uD558\uD558!
    \uADF8\uB807\uB2E4\uBA74 \uC774\uACF3\uC740 \uC6B4\uBA85\uC758 \uC778\uB3C4\uC600\uB358
    \uAC83\uC774\uB85C\uAD6C\uB098.\r\n\uBE44\uB85D \uC9C0\uAE08\uC740 \uAE38\uBC14\uB2E5\uC5D0\uC11C
    \uC7A0\uC744 \uCCAD\uD558\uB294 \uC2E0\uC138\uAC00 \uB418\uC5C8\uC9C0\uB9CC,
    \uAE30\uC0AC\uC758 \uD600\uB294 \uC544\uC9C1 \uC0B4\uC544 \uC788\uB290\uB2C8.\r\n\uC790,
    \uC5B4\uB514 \uD655\uC778\uD574 \uBCF4\uB3C4\uB85D \uD558\uB9C8\r\n\uD584\uBD80\uAE30\uD584\uBD81
    \uD584\uBD81\uC2A4\uB531\uC2A4 \uD568\uBD80\uB974\uD06C\uD584\uBD80\uAC00\uC6B0\uAC00
    \uD584\uBE44\uAE30\uD584\uBD80\uAC70 \uD584\uBD80\uAC00\uD2F0\uD584\uBD80\uAE30\uC628\uC564
    \uC628\uC744 \uCC28\uB824\uC624\uAC70\uB77C"
  perfectDialogue:
  - "\uC624\uC624\uC624\uC624!!\r\n\uC774\uAC83\uC740...!\r\n\uD2C0\uB9BC\uC5C6\uB2E4!
    \uC655\uAD6D\uC758 \uB300\uC5F0\uD68C\uC5D0\uC11C\uC870\uCC28 \uB9DB\uBCF4\uAE30
    \uC5B4\uB824\uC6B4 \uC9C4\uC815\uD55C \uD584\uBD80\uAE30\uD584\uBD81 \uD584\uBD81\uC2A4\uB531\uC2A4
    \uD568\uBD80\uB974\uD06C\uD584\uD584\uBD80\uAC00\uC6B0\uAC00 \uD584\uBE44\uAE30\uD584\uBD80\uAC70
    \uD584\uBD80\uAC00\uD2F0\uD584\uBD80\uAE30\uC628\uC564 \uC628!\r\n\uAE30\uC0AC\uC758
    \uBA85\uC608\uB97C \uAC78\uACE0 \uB9F9\uC138\uD558\uAC74\uB300, \uC624\uB298\uC740
    \uC2E4\uB85C \uC704\uB300\uD55C \uB0A0\uC774\uB85C\uB2E4!\r\n\uADF8\uB300\uC758
    \uC19C\uC528\uB294 \uC655\uC2E4 \uC8FC\uBC29\uC7A5\uC5D0 \uACAC\uC8FC\uC5B4\uB3C4
    \uC190\uC0C9\uC774 \uC5C6\uACA0\uAD6C\uB098!\r\n...\uC74C? \uB300\uAE08 \uB9D0\uC774\uB354\uB0D0?\r\n\u2026.\r\n\uB2E4\uC74C\uC5D0
    \uAF2D \uAC00\uC838\uC624\uB3C4\uB85D \uD558\uACA0\uB124!"
  incompleteDialogue:
  - "\uC624\uC624\uC624\uC624!!\r\n\uC774\uAC83\uC740...!\r\n\uD2C0\uB9BC\uC5C6\uB2E4!
    \uC655\uAD6D\uC758 \uB300\uC5F0\uD68C\uC5D0\uC11C\uC870\uCC28 \uB9DB\uBCF4\uAE30
    \uC5B4\uB824\uC6B4 \uC9C4\uC815\uD55C \uD584\uBD80\uAE30\uD584\uBD81 \uD584\uBD81\uC2A4\uB531\uC2A4
    \uD568\uBD80\uB974\uD06C\uD584\uD584\uBD80\uAC00\uC6B0\uAC00 \uD584\uBE44\uAE30\uD584\uBD80\uAC70
    \uD584\uBD80\uAC00\uD2F0\uD584\uBD80\uAE30\uC628\uC564 \uC628!\r\n\uAE30\uC0AC\uC758
    \uBA85\uC608\uB97C \uAC78\uACE0 \uB9F9\uC138\uD558\uAC74\uB300, \uC624\uB298\uC740
    \uC2E4\uB85C \uC704\uB300\uD55C \uB0A0\uC774\uB85C\uB2E4!\r\n\uADF8\uB300\uC758
    \uC19C\uC528\uB294 \uC655\uC2E4 \uC8FC\uBC29\uC7A5\uC5D0 \uACAC\uC8FC\uC5B4\uB3C4
    \uC190\uC0C9\uC774 \uC5C6\uACA0\uAD6C\uB098!\r\n...\uC74C? \uB300\uAE08 \uB9D0\uC774\uB354\uB0D0?\r\n\u2026.\r\n\uB2E4\uC74C\uC5D0
    \uAF2D \uAC00\uC838\uC624\uB3C4\uB85D \uD558\uACA0\uB124!"
  wrongDialogue:
  - "\uC74C...\r\n\uC774\uB9DB\uC740\u2026. \uAC10\uD788 \uADC0\uC871\uC744 \uB2A5\uBA78\uD558\uB294
    \uAC83\uC774\uB0D0?\r\n\u2026..\r\n\uADF8\uB7F0 \uC758\uB3C4\uB294 \uC544\uB2C8\uC5C8\uB358
    \uAC83 \uAC19\uAD70\r\n\uBD84\uBA85 \uADF8 \uD5A5\uAE30\uB294 \uB9DE\uC558\uAC70\uB298,
    \uC5B4\uB518\uAC00 \uB9CE\uC774 \uBD80\uC871\uD558\uAD6C\uB098.\r\n\uC804\uC124\uC5D0
    \uBE44\uD558\uBA74 \uC544\uC9C1 \uC218\uB828\uC774 \uB354 \uD544\uC694\uD558\uACA0\uB290\uB2C8\uB77C.\r\n\uD5C8\uB098
    \uB099\uB2F4\uD558\uC9C0 \uB9D0\uAC70\uB77C. \uC704\uB300\uD55C \uC694\uB9AC\uB3C4
    \uCC98\uC74C\uBD80\uD130 \uC644\uBCBD\uD558\uC9C4 \uC54A\uC558\uC73C\uB2C8.\r\n...\uC74C?
    \uB300\uAE08 \uB9D0\uC774\uB354\uB0D0?\r\n\u2026.\r\n\uAD6D\uC655\uC758 \uAC00\uD638\uAC00
    \uD568\uAED8 \uD558\uAE38!"
